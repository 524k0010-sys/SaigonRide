<!DOCTYPE html>
<html translate="no" class="notranslate">
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - SaigonRide</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    @{
        var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
        var langCookie = Request.Cookies["sr_lang"];
        var isVi = langCookie != null && string.Equals(langCookie.Value, "vi", StringComparison.OrdinalIgnoreCase);
        var returnUrl = Request.RawUrl;
        var isAdmin = Request.IsAuthenticated && User.IsInRole("Admin");
        var isRentPage = currentController == "Rentals" && currentAction == "Available";
        var isReturnPage = currentController == "Rentals" &&
            (currentAction == "ReturnVehicles" ||
             currentAction == "ReturnVehicle" ||
             currentAction == "TripInProgress" ||
             currentAction == "Checkout" ||
             currentAction == "Success");
    }

    <nav class="navbar navbar-expand-lg saigon-navbar">
        <div class="container-fluid px-4">
            <a class="navbar-brand saigon-brand" href="@Url.Action("Index", "Home")">
                <span class="brand-mark">SR</span>
                <span>SaigonRide</span>
            </a>

            <button type="button"
                    class="navbar-toggler saigon-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#saigonNavbar"
                    aria-controls="saigonNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="saigonNavbar" class="collapse navbar-collapse">
                <ul class="navbar-nav saigon-menu me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Home" ? "active" : "")"
                           href="@Url.Action("Index", "Home")">@(isVi ? "Trang chủ" : "Home")</a>
                    </li>

                    @if (!isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(isRentPage ? "active" : "")"
                               href="@Url.Action("Available", "Rentals")">@(isVi ? "Thuê xe" : "Rent Vehicle")</a>
                        </li>

                        if (Request.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link saigon-link @(isReturnPage ? "active" : "")"
                                   href="@Url.Action("ReturnVehicles", "Rentals")">@(isVi ? "Trả xe" : "Return Vehicle")</a>
                            </li>
                        }
                    }

                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "Vehicles" && currentAction == "Tracking" ? "active" : "")"
                               href="@Url.Action("Tracking", "Vehicles")">@(isVi ? "Theo dõi" : "Tracking")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "Vehicles" && currentAction != "Tracking" ? "active" : "")"
                               href="@Url.Action("Index", "Vehicles")">@(isVi ? "Xe" : "Vehicles")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "Stations" ? "active" : "")"
                               href="@Url.Action("Index", "Stations")">@(isVi ? "Trạm" : "Stations")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "VehicleCategories" ? "active" : "")"
                               href="@Url.Action("Index", "VehicleCategories")">@(isVi ? "Loại xe" : "Categories")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "Reports" && currentAction == "Inventory" ? "active" : "")"
                               href="@Url.Action("Inventory", "Reports")">@(isVi ? "Tồn kho" : "Inventory")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link saigon-link @(currentController == "Reports" && currentAction == "Revenue" ? "active" : "")"
                               href="@Url.Action("Revenue", "Reports")">@(isVi ? "Doanh thu" : "Revenue")</a>
                        </li>
                    }
                </ul>
            </div>
            <div class="language-toggle me-3" role="group" aria-label="Language">
                <a class="lang-option @(isVi ? "" : "active")"
                   href="@Url.Action("SetLanguage", "Home", new { lang = "en", returnUrl = returnUrl })">EN</a>
                <a class="lang-option @(isVi ? "active" : "")"
                   href="@Url.Action("SetLanguage", "Home", new { lang = "vi", returnUrl = returnUrl })">VI</a>
            </div>
            <div class="d-flex align-items-center saigon-login">
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <main class="saigon-page">
        <div class="container-fluid px-4">
            <div class="saigon-content">
                @RenderBody()

                <footer class="saigon-footer">
                    <span>&copy; @DateTime.Now.Year SaigonRide</span>
                    <span>@(isVi ? "Hệ thống thuê xe phân tán" : "Distributed Vehicle Rental System")</span>
                </footer>
            </div>
        </div>
    </main>

