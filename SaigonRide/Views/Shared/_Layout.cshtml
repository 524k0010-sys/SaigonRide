<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - SaigonRide Admin</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    }

    <nav class="navbar navbar-expand-sm navbar-dark admin-navbar">
        <div class="container">
            <a class="navbar-brand admin-brand" href="@Url.Action("Index", "Home")">
                <span class="brand-mark">SR</span>
                <span>SaigonRide Admin</span>
            </a>

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    title="Toggle navigation"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav admin-menu flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "Home" ? "active" : "")"
                           href="@Url.Action("Index", "Home")">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "Vehicles" ? "active" : "")"
                           href="@Url.Action("Index", "Vehicles")">
                            Vehicles
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "Stations" ? "active" : "")"
                           href="@Url.Action("Index", "Stations")">
                            Stations
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "VehicleCategories" ? "active" : "")"
                           href="@Url.Action("Index", "VehicleCategories")">
                            Categories
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "Reports" && currentAction == "Inventory" ? "active" : "")"
                           href="@Url.Action("Inventory", "Reports")">
                            Inventory Report
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link admin-nav-link @(currentController == "Reports" && currentAction == "Revenue" ? "active" : "")"
                           href="@Url.Action("Revenue", "Reports")">
                            Revenue Report
                        </a>
                    </li>
                </ul>

                <div class="admin-login-area">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="admin-shell">
        <div class="container body-content admin-content">
            @RenderBody()

            <footer class="admin-footer">
                <span>&copy; @DateTime.Now.Year SaigonRide</span>
                <span>Distributed Vehicle Rental System</span>
            </footer>
        </div>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
