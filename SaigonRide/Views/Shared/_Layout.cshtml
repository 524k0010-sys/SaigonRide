<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - SaigonRide Admin</title>

    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    @{
        var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    }

    <nav class="navbar navbar-expand-lg saigon-navbar">
        <div class="container-fluid px-4">
            <a class="navbar-brand saigon-brand" href="@Url.Action("Index", "Home")">
                <span class="brand-mark">SR</span>
                <span>SaigonRide Admin</span>
            </a>

            <button type="button"
                    class="navbar-toggler saigon-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#saigonNavbar"
                    aria-controls="saigonNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="saigonNavbar" class="collapse navbar-collapse">
                <ul class="navbar-nav saigon-menu me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Home" ? "active" : "")"
                           href="@Url.Action("Index", "Home")">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Rentals" ? "active" : "")"
                           href="@Url.Action("Available", "Rentals")">Rent Vehicle</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Vehicles" ? "active" : "")"
                           href="@Url.Action("Index", "Vehicles")">Vehicles</a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Stations" ? "active" : "")"
                           href="@Url.Action("Index", "Stations")">Stations</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "VehicleCategories" ? "active" : "")"
                           href="@Url.Action("Index", "VehicleCategories")">Categories</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Reports" && currentAction == "Inventory" ? "active" : "")"
                           href="@Url.Action("Inventory", "Reports")">Inventory</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link saigon-link @(currentController == "Reports" && currentAction == "Revenue" ? "active" : "")"
                           href="@Url.Action("Revenue", "Reports")">Revenue</a>
                    </li>
                </ul>

                <div class="saigon-login">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="saigon-page">
        <div class="container-fluid px-4">
            <div class="saigon-content">
                @RenderBody()

                <footer class="saigon-footer"><li class="nav-item">
    <a class="nav-link saigon-link @(currentController == "Home" ? "active" : "")"
       href="@Url.Action("Index", "Home")">Dashboard</a>
</li>

<li class="nav-item">
    <a class="nav-link saigon-link @(currentController == "Vehicles" ? "active" : "")"
       href="@Url.Action("Index", "Vehicles")">Vehicles</a>
</li>

                    <span>&copy; @DateTime.Now.Year SaigonRide</span>
                    <span>Distributed Vehicle Rental System</span>
                </footer>
            </div>
        </div>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
