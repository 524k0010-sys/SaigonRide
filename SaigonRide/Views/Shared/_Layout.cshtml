            var translations = @((isVi ? "true" : "false")) ? toVi : toEn;

            function translateValue(value) {
                if (!value) {
                    return value;
                }

                var trimmed = value.trim();
                return translations[trimmed] || value;
            }

            function translateTextNode(node) {
                var value = node.nodeValue;
                var trimmed = value.trim();
                var translated = translations[trimmed];

                if (translated) {
                    node.nodeValue = value.replace(trimmed, translated);
                }
            }

            function walk(root) {
                var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                    acceptNode: function (node) {
                        var parent = node.parentNode;
                        if (!parent || /^(SCRIPT|STYLE|TEXTAREA)$/i.test(parent.nodeName)) {
                            return NodeFilter.FILTER_REJECT;
                        }

                        return node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
                    }
                });

                var nodes = [];
                while (walker.nextNode()) {
                    nodes.push(walker.currentNode);
                }

                nodes.forEach(translateTextNode);
            }

            walk(document.body);

            document.querySelectorAll("input[type='submit'], input[type='button']").forEach(function (input) {
                input.value = translateValue(input.value);
            });

            document.querySelectorAll("[placeholder]").forEach(function (element) {
                element.setAttribute("placeholder", translateValue(element.getAttribute("placeholder")));
            });

            var titleSuffix = " - SaigonRide";
            if (document.title.indexOf(titleSuffix) > -1) {
                var rawTitle = document.title.replace(titleSuffix, "");
                var translatedTitle = translations[rawTitle];
                if (translatedTitle) {
                    document.title = translatedTitle + titleSuffix;
                }
            }
        })();
