<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - SaigonRide Admin</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("SaigonRide Admin", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold" })

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    title="Toggle navigation"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Dashboard", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Vehicles", "Index", "Vehicles", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Stations", "Index", "Stations", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Categories", "Index", "VehicleCategories", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Inventory Report", "Inventory", "Reports", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Revenue Report", "Revenue", "Reports", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>

                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <main class="container body-content">
        @RenderBody()

        <hr />

        <footer class="text-muted small pb-3">
            <p>&copy; @DateTime.Now.Year - SaigonRide Distributed Vehicle Rental System</p>
        </footer>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
