@model IEnumerable<SaigonRide.Models.Vehicle>

@{
    ViewBag.Title = "Available Vehicles";
}

<div class="admin-page-header">
    <h2>Available Vehicles</h2>
    <p>Select a ready vehicle to start a rental trip.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Vehicle Code</th>
                <th>Category</th>
                <th>Price / Minute</th>
                <th>Station</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleCode</td>
                    <td>@item.VehicleCategory.Name</td>
                    <td>@item.VehicleCategory.PricePerMinute.ToString("N0") VND</td>
                    <td>@item.Station.Name</td>
                    <td><span class="badge bg-success">Ready</span></td>
                    <td>
                        @Html.ActionLink("Start Trip", "StartTrip", "Rentals", new { id = item.Id }, new { @class = "btn btn-success btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
